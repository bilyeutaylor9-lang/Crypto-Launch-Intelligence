# Do not commit real secret values.
NODE_ENV=production

# Primary live-chain acquisition. Use authenticated/reliable RPCs in production;
# public fallbacks are continuity aids, not a production health attestation.
BASE_RPC_URL=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
AVALANCHE_RPC_URL=
SOLANA_RPC_URL=
HELIUS_RPC_URL=

# Native event collection. Only list chains that have real RPC/program coverage.
NATIVE_DISCOVERY_COLLECT=true
NATIVE_DISCOVERY_CHAINS=base
NATIVE_PUBLIC_RPC_FALLBACKS=false
SOLANA_PUMP_FUN_PROGRAM=
SOLANA_RAYDIUM_LAUNCHLAB_PROGRAM=
SOLANA_RAYDIUM_CPMM_PROGRAM=
SOLANA_RAYDIUM_CLMM_PROGRAM=
SOLANA_METEORA_DBC_PROGRAM=
SOLANA_METEORA_DLMM_PROGRAM=

# Free/public market-context sources use built-in endpoints. Optional keys improve
# quotas but are not evidence by themselves.
COINGECKO_API_TIER=
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
COINGECKO_BASE_URL=
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
MARKET_PROVIDER_TIMEOUT_MS=12000

# Optional premium/secondary market sources. A configured key does not count as
# healthy until the corresponding live source report records successful data.
BIRDEYE_API_KEY=
COINMARKETCAP_API_KEY=
COINCAP_API_KEY=
DEXTOOLS_API_KEY=
CRYPTOCOMPARE_API_KEY=
MESSARI_API_KEY=
MOBULA_API_KEY=

# Explorer and security enrichment.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
SOLSCAN_API_KEY=
GOPLUS_API_KEY=
TOKENSNIFFER_API_KEY=
RUGCHECK_API_BASE_URL=https://api.rugcheck.xyz/v1
BLOCKSCOUT_BASE_URL=

# Optional independent news, developer, social and wallet evidence.
GITHUB_TOKEN=
CRYPTOPANIC_API_KEY=
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
REDDIT_API_KEY=
DEBANK_API_KEY=
ZERION_API_KEY=
ARKHAM_API_KEY=
NANSEN_API_KEY=

# Optional remote persistence. The existing repository can fall back to SQLite.
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Exact forward-outcome and context capture.
OUTCOME_PROBE_HORIZONS=1,24,168,720
OUTCOME_PROBE_MAX_CANDIDATES=120
OUTCOME_PROBE_MAX_REQUESTS=120
OUTCOME_PROBE_CONCURRENCY=4
OUTCOME_PROBE_GECKO_MINIMUM_INTERVAL_MS=6100

# Optional forward execution-cost evidence. This is an authenticated or public
# quote adapter you operate/configure; it must be quote-only. A scan captures a
# bounded, fresh BUY→SELL pair at the reference notional and freezes it only
# for shadow prospective evaluation. It cannot create orders or alter ranking.
IGNITION_EXECUTABLE_QUOTE_ENDPOINT=
IGNITION_EXECUTABLE_QUOTE_BEARER=
IGNITION_EXECUTABLE_QUOTE_PROVIDER=
FORWARD_EXECUTION_COST_REFERENCE_NOTIONAL_USD=100
FORWARD_EXECUTION_COST_MAX_CANDIDATES=25
FORWARD_EXECUTION_COST_MAX_QUOTE_AGE_MS=30000
FORWARD_EXECUTION_COST_MAX_PAIR_SKEW_MS=15000

# Model governance.
EDGE_MODEL_VERSION=shadow-v1

# Research-only defaults.
EDGE_RESEARCH_PRIORITY_LIMIT=100
EDGE_FAST_EVIDENCE_MAX_REQUESTS=30
EDGE_FAST_EVIDENCE_CONCURRENCY=4
IGNITION_GENOME_WINDOW_MINUTES=360
IGNITION_GENOME_HORIZON_HOURS=24
IGNITION_GENOME_TOP_K=25


# External backup/PITR attestation. Set only after verifying the provider setting.
PRODUCTION_REMOTE_BACKUP_VERIFIED=false
PRODUCTION_REMOTE_BACKUP_PROVIDER=
PRODUCTION_REMOTE_BACKUP_VERIFIED_AT=
