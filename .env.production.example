# Do not commit real secret values.
NODE_ENV=production

# Required for Base chain acquisition.
BASE_RPC_URL=

# Optional remote persistence. The existing repository can fall back to SQLite.
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Model governance.
EDGE_MODEL_VERSION=shadow-v1

# Research-only defaults.
EDGE_RESEARCH_PRIORITY_LIMIT=100
EDGE_FAST_EVIDENCE_MAX_REQUESTS=30
EDGE_FAST_EVIDENCE_CONCURRENCY=4
IGNITION_GENOME_WINDOW_MINUTES=360
IGNITION_GENOME_HORIZON_HOURS=24
IGNITION_GENOME_TOP_K=25


# External backup/PITR attestation. Set only after verifying the provider setting.
PRODUCTION_REMOTE_BACKUP_VERIFIED=false
PRODUCTION_REMOTE_BACKUP_PROVIDER=
PRODUCTION_REMOTE_BACKUP_VERIFIED_AT=
