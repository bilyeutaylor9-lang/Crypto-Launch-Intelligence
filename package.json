{
  "name": "crypto-launch-intelligence",
  "version": "0.5.0",
  "description": "AI-powered crypto launch intelligence platform for discovering early momentum shifts, launch opportunities, smart money accumulation, and emerging crypto narratives.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cli": "./src/cli.js",
    "crypto-launch": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/demo.js",
    "scan:demo": "node src/demo.js",
    "scan": "node src/index.js",
    "scan:full": "node src/index.js",
    "scan:wide": "WIDE_SCAN=true WIDE_SCAN_LIMIT=10000 DISCOVERY_SCAN_LIMIT=10000 FREE_SOURCE_LIMIT=10000 EXPANDED_SOURCE_LIMIT=10000 INTERNET_RESEARCH_PROJECT_LIMIT=100 WEB_RESEARCH_AGENT_LIMIT=100 npm run scan",
    "scan:op": "WIDE_SCAN=true WIDE_SCAN_LIMIT=10000 DISCOVERY_SCAN_LIMIT=10000 FREE_SOURCE_LIMIT=10000 EXPANDED_SOURCE_LIMIT=10000 INTERNET_RESEARCH_PROJECT_LIMIT=100 WEB_RESEARCH_AGENT_LIMIT=100 BREAKOUT_BRAIN_SIMULATIONS=4096 npm run scan",
    "scan:rescue": "CANDIDATE_RESCUE_THRESHOLD=1500 CANDIDATE_RESCUE_LIMIT=500 RESEARCH_SEED_SUPPLEMENT_THRESHOLD=500 npm run scan",
    "scan:test": "node src/index.js",
    "test": "node --test test/*.test.js",
    "tokens": "node src/showTokens.js",
    "discover": "node src/showTokens.js",
    "discover:wide": "WIDE_SCAN=true WIDE_SCAN_LIMIT=10000 DISCOVERY_SCAN_LIMIT=10000 FREE_SOURCE_LIMIT=10000 EXPANDED_SOURCE_LIMIT=10000 node src/discoveryManager.js",
    "discovery": "node src/discoveryManager.js",
    "market": "node src/liveMarketScanner.js",
    "scan:live": "node src/liveMarketScanner.js",
    "report": "node src/index.js",
    "reports": "node src/index.js",
    "dashboard": "open reports/report.html",
    "html": "open reports/report.html",
    "json": "cat reports/report.json",
    "csv": "open reports/opportunities.csv",
    "quantum": "cat reports/quantum-field.json",
    "backtest": "node src/outcomeBacktest.js",
    "learn": "node src/outcomeBacktest.js",
    "calibrate": "node src/outcomeBacktest.js",
    "patterns": "node src/prePumpPatterns.js",
    "sources": "node src/data/dataSourceManager.js",
    "sources:expanded": "node src/data/expandedMarketDataConnector.js",
    "sources:seeds": "node src/data/fallbackResearchSeedConnector.js",
    "source-router": "node src/data/adaptiveSourceRouter.js",
    "sources:router": "node src/data/adaptiveSourceRouter.js",
    "sources:github": "node src/data/githubProjectDiscoveryConnector.js",
    "sources:ai-swarm": "node src/data/aiDiscoverySwarmEngine.js",
    "research:internet": "node src/data/internetResearchConnector.js",
    "research:webcrawl": "FREE_WEBCRAWL_ENABLED=true node src/data/internetResearchConnector.js",
    "research:memory": "node src/learning/internetResearchMemoryStore.js",
    "watchtower": "node src/watchtower.js",
    "watchtower:daemon": "node src/watchtowerDaemon.js",
    "watchtower:performance": "node src/watchtowerPerformance.js",
    "alerts": "cat reports/alerts.json",
    "brief": "cat reports/daily-brief.json",
    "alert-performance": "cat reports/watchtower-performance.json",
    "state-signals": "cat reports/state-of-art-signals.json",
    "ai-council": "cat reports/ai-council.json",
    "agent-performance": "cat reports/agent-performance.json",
    "agent-memory": "node src/learning/agentPerformanceMemoryStore.js",
    "research-os": "cat reports/research-os.json",
    "alpha-lab": "cat reports/alpha-lab.json",
    "simulation-brain": "cat reports/simulation-brain.json",
    "outcome-judge": "cat reports/outcome-judge.json",
    "catalyst-radar": "cat reports/catalyst-radar.json",
    "dossier-swarm": "cat reports/dossier-swarm.json",
    "ai-command-center": "cat reports/ai-command-center.json",
    "research-commander": "cat reports/ai-research-commander.json",
    "alpha-investigator": "cat reports/alpha-investigator.json",
    "portfolio-war-room": "cat reports/portfolio-war-room.json",
    "strategy-lab": "cat reports/strategy-lab.json",
    "causal-brain": "cat reports/causal-alpha-brain.json",
    "alpha-os": "cat reports/autonomous-alpha-os.json",
    "alpha-dashboard-v2": "cat reports/alpha-dashboard-v2.json",
    "paper-lab": "cat reports/paper-trading-lab.json",
    "weight-optimizer": "cat reports/weight-optimizer.json",
    "source-truth": "cat reports/source-truth.json",
    "github-pro": "cat reports/github-intelligence-pro.json",
    "autonomous-research": "cat reports/autonomous-research.json",
    "breakout-brain": "cat reports/breakout-brain.json",
    "breakouts": "cat reports/breakout-brain.json",
    "high-tech": "cat reports/high-tech-alpha-stack.json",
    "alpha-stack": "cat reports/high-tech-alpha-stack.json",
    "self-evolving-alpha-os": "cat reports/self-evolving-alpha-os.json",
    "alpha:os": "cat reports/self-evolving-alpha-os.json",
    "alpha:thesis": "cat reports/alpha-theses.json",
    "alpha:debate": "node -e \"const r=require('./reports/self-evolving-alpha-os.json'); console.log(JSON.stringify((r.topProjects||[]).map(p=>({rank:p.rank,symbol:p.symbol,decision:p.decision,committee:p.agentSociety?.committeeDecision,agents:p.agentSociety?.agents})).slice(0,10), null, 2))\"",
    "alpha:autopsy": "node -e \"const r=require('./reports/self-evolving-alpha-os.json'); console.log(JSON.stringify((r.topProjects||[]).map(p=>({rank:p.rank,symbol:p.symbol,decision:p.decision,autopsy:p.alphaAutopsy})).slice(0,25), null, 2))\"",
    "alpha:regime": "node -e \"const r=require('./reports/self-evolving-alpha-os.json'); console.log(JSON.stringify((r.topProjects||[]).map(p=>({rank:p.rank,symbol:p.symbol,decision:p.decision,regime:p.regimeAdaptation})).slice(0,25), null, 2))\"",
    "strategy-memory": "node src/learning/strategyMemoryStore.js",
    "paper-memory": "node src/learning/paperTradingOutcomeStore.js",
    "research-memory": "node src/learning/autonomousResearchMemoryStore.js",
    "roadmap": "node src/roadmap.js",
    "engine:audit": "node src/engineHealthCheck.js",
    "engine:audit:json": "cat reports/engine-audit.json",
    "publish:dashboard": "node src/reports/githubPagesPublisher.js",
    "watchlist": "cat reports/watchlist.json",
    "summary": "cat reports/summary.txt",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
