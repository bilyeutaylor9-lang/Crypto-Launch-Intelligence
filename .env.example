# Crypto Launch Intelligence OP Mode template
# Copy the keys you actually have into .env or GitHub Secrets.
# Never commit real secrets.

# Core AI research layer
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5

# Local AI brain for Llama 3 / Ollama / LM Studio / llama.cpp
# Ollama example:
# LOCAL_AI_PROVIDER=ollama
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434
# LOCAL_AI_MODEL=llama3.1:8b
# OpenAI-compatible local server example:
# LOCAL_AI_PROVIDER=openai-compatible
# LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
# LOCAL_AI_MODEL=llama-3.1-8b-instruct
# LOCAL_AI_API_KEY=optional_local_server_key
LOCAL_AI_MODE=AUTO
LOCAL_AI_INLINE_LIMIT=1
LOCAL_AI_TOP_PROJECT_LIMIT=100
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT_MS=90000
LOCAL_AI_MAX_TOKENS=450
LOCAL_AI_JSON_MODE=true

# Institutional analysis funnel
DISCOVERY_TARGET_CANDIDATES=39000
WIDE_SCAN_LIMIT=39000
DISCOVERY_SCAN_LIMIT=39000
STANDARD_INTELLIGENCE_LIMIT=4000
INTELLIGENCE_PIPELINE_LIMIT=4000
ADVANCED_INTELLIGENCE_LIMIT=1500
DEEP_INTELLIGENCE_LIMIT=500
CRAWLER_RESEARCH_LIMIT=300
FINALIST_DEBATE_LIMIT=25
FINALIST_COMPARISON_LIMIT=5
WINNER_LIMIT=1

# Market and liquidity coverage
BIRDEYE_API_KEY=your_birdeye_key_here
COINGECKO_API_KEY=optional_generic_coingecko_key_here
COINGECKO_PRO_API_KEY=optional_coingecko_pro_key_here
COINGECKO_DEMO_API_KEY=optional_coingecko_demo_key_here
COINGECKO_API_TIER=demo
COINGECKO_INCLUDE_COIN_LIST=true
COINGECKO_COIN_LIST_LIMIT=20000
COINCAP_API_KEY=your_coincap_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here
CRYPTOCOMPARE_API_KEY=your_cryptocompare_key_here
DEXTOOLS_API_KEY=your_dextools_key_here
MESSARI_API_KEY=optional_messari_key_here
MOBULA_API_KEY=optional_mobula_key_here

# Institutional candidate policy
# Utility-first is the default. Set false only if you intentionally want meme research.
EXCLUDE_MEME_CANDIDATES=true

# Quote-only execution proof (never sends a transaction)
EXECUTION_RECOVERY_ENABLED=true
EXECUTION_RECOVERY_MAX_CANDIDATES=25
EXECUTION_RECOVERY_TRADE_SIZES_USD=100
EXECUTION_RECOVERY_TIMEOUT_MS=300000
EXECUTION_RECOVERY_REQUEST_TIMEOUT_MS=12000
EXECUTION_RECOVERY_CONCURRENCY=2
LIFI_EXECUTION_RECOVERY_ENABLED=true
LIFI_API_KEY=optional_higher_rate_limit_key_here
LIFI_INTEGRATOR=crypto-launch-intel
JUPITER_API_KEY=optional_jupiter_key_here
ZEROX_API_KEY=optional_0x_fallback_key_here
# Optional quote context only; use a valid EVM address. No transaction is submitted.
EXECUTION_QUOTE_TAKER_ADDRESS=0x0000000000000000000000000000000000000001

# Optional forward-evidence execution-cost capture (read-only paired BUY/SELL
# quotes; never submits a transaction and never changes scan ranking). The
# endpoint must return a fresh timestamp, all-in cost and price impact for both
# sides. Leave blank to keep prospective execution costs explicitly unknown.
IGNITION_EXECUTABLE_QUOTE_ENDPOINT=
IGNITION_EXECUTABLE_QUOTE_BEARER=
IGNITION_EXECUTABLE_QUOTE_PROVIDER=
FORWARD_EXECUTION_COST_REFERENCE_NOTIONAL_USD=100
FORWARD_EXECUTION_COST_MAX_CANDIDATES=25
FORWARD_EXECUTION_COST_MAX_QUOTE_AGE_MS=30000
FORWARD_EXECUTION_COST_MAX_PAIR_SKEW_MS=15000

# Social, news, and catalyst coverage
X_BEARER_TOKEN=your_x_bearer_token_here
TWITTER_BEARER_TOKEN=optional_twitter_bearer_token_here
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here
REDDIT_API_KEY=optional_reddit_key_here
TELEGRAM_BOT_TOKEN=optional_telegram_bot_token_here
DISCORD_BOT_TOKEN=optional_discord_bot_token_here

# Developer and repository coverage
GITHUB_TOKEN=your_github_token_here

# Explorer and contract truth
# Etherscan API V2 can verify ABI/source/creator data across supported EVM chains with chainid.
ETHERSCAN_API_KEY=your_etherscan_key_here
BASESCAN_API_KEY=optional_legacy_basescan_key_here
BSCSCAN_API_KEY=optional_legacy_bscscan_key_here
ARBISCAN_API_KEY=optional_legacy_arbiscan_key_here
OPTIMISTIC_ETHERSCAN_API_KEY=optional_legacy_optimistic_etherscan_key_here
POLYGONSCAN_API_KEY=optional_legacy_polygonscan_key_here
SNOWTRACE_API_KEY=optional_snowtrace_key_here
SOLSCAN_API_KEY=your_solscan_key_here

# Wallet and smart-money coverage
ARKHAM_API_KEY=your_arkham_key_here
NANSEN_API_KEY=your_nansen_key_here
DEBANK_API_KEY=optional_debank_key_here
ZERION_API_KEY=optional_zerion_key_here

# Extra safety coverage
TOKENSNIFFER_API_KEY=optional_tokensniffer_key_here

# Optional Supabase sync
# Run supabase/schema.sql in your Supabase SQL Editor first.
# Prefer SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY for server-side scanner sync.
# Never expose server-write keys in a public frontend.
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=optional_supabase_anon_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ACCESS_TOKEN=optional_supabase_cli_access_token_for_migrations
SUPABASE_SYNC_REQUIRED=false
SUPABASE_SYNC_PROJECT_LIMIT=500
SUPABASE_SYNC_REPORTS=true
SUPABASE_SYNC_ALPHA_RECEIPTS=true
SUPABASE_MEMORY_ENABLED=true
SUPABASE_MEMORY_RUN_LIMIT=25
SUPABASE_MEMORY_PROJECT_LIMIT=2500
SUPABASE_MEMORY_RECEIPT_LIMIT=1000
SUPABASE_HEALTH_WRITE=false
SUPABASE_SCAN_RUNS_TABLE=scan_runs
SUPABASE_SCAN_PROJECTS_TABLE=scan_projects
SUPABASE_SCAN_REPORTS_TABLE=scan_reports
SUPABASE_ALPHA_RECEIPTS_TABLE=alpha_truth_receipts

# Alpha Truth Kernel persistence
ALPHA_TRUTH_PERSIST_ENABLED=true
ALPHA_TRUTH_RECEIPT_LIMIT=100
ALPHA_TRUTH_PERSIST_LIMIT=250

# Native launch/pool event collection
NATIVE_DISCOVERY_COLLECT=false
NATIVE_DISCOVERY_CHAINS=base,solana,bsc,polygon,arbitrum,ethereum,optimism,avalanche

# Chain RPC/WebSocket access for native monitoring
BASE_RPC_URL=your_base_rpc_url_here
BASE_WS_URL=optional_base_websocket_url_here
ETHEREUM_RPC_URL=optional_ethereum_rpc_url_here
ETHEREUM_WS_URL=optional_ethereum_websocket_url_here
BSC_RPC_URL=your_bsc_rpc_url_here
BSC_WS_URL=optional_bsc_websocket_url_here
POLYGON_RPC_URL=your_polygon_rpc_url_here
POLYGON_WS_URL=optional_polygon_websocket_url_here
ARBITRUM_RPC_URL=your_arbitrum_rpc_url_here
ARBITRUM_WS_URL=optional_arbitrum_websocket_url_here
SOLANA_RPC_URL=your_solana_rpc_url_here
SOLANA_WS_URL=optional_solana_websocket_url_here
HELIUS_API_KEY=optional_helius_key_here
EVM_DEPLOYMENT_RADAR_RPC_URL=your_evm_deployment_rpc_url_here

# Native protocol identifiers
BASE_AERODROME_FACTORY=your_base_aerodrome_factory_here
BASE_AERODROME_SLIPSTREAM_FACTORY=your_base_aerodrome_slipstream_factory_here
BASE_UNISWAP_V3_FACTORY=your_base_uniswap_v3_factory_here
BASE_UNISWAP_V4_POOL_MANAGER=your_base_uniswap_v4_pool_manager_here
BSC_PANCAKESWAP_V2_FACTORY=your_bsc_pancakeswap_v2_factory_here
BSC_PANCAKESWAP_V3_FACTORY=your_bsc_pancakeswap_v3_factory_here
POLYGON_QUICKSWAP_ALGEBRA_FACTORY=your_polygon_quickswap_algebra_factory_here
ARBITRUM_CAMELOT_FACTORY=your_arbitrum_camelot_factory_here
SOLANA_PUMP_FUN_PROGRAM=your_solana_pump_fun_program_here
SOLANA_RAYDIUM_LAUNCHLAB_PROGRAM=your_solana_raydium_launchlab_program_here
SOLANA_RAYDIUM_CPMM_PROGRAM=your_solana_raydium_cpmm_program_here
SOLANA_RAYDIUM_CLMM_PROGRAM=your_solana_raydium_clmm_program_here
SOLANA_METEORA_DBC_PROGRAM=your_solana_meteora_dbc_program_here
SOLANA_METEORA_DLMM_PROGRAM=your_solana_meteora_dlmm_program_here

# Wide scan controls
WIDE_SCAN=true
DISCOVERY_TARGET_CANDIDATES=39000
WIDE_SCAN_LIMIT=39000
DISCOVERY_SCAN_LIMIT=39000
FREE_SOURCE_LIMIT=39000
EXPANDED_SOURCE_LIMIT=39000
GOOGLE_NEWS_DISCOVERY_LIMIT=1000
GITHUB_DISCOVERY_LIMIT=1000
NATIVE_DISCOVERY_LIMIT=5000
INTERNET_RESEARCH_PROJECT_LIMIT=150
WEB_RESEARCH_AGENT_LIMIT=150
